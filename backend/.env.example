# Đổi tên file này thành .env rồi điền giá trị thật, KHÔNG commit file .env lên GitHub

PORT=4000

# Thông tin kết nối PostgreSQL
DATABASE_URL=postgres://postgres:matkhau@localhost:5432/pm_studio

# Chuỗi bí mật để ký JWT — đổi thành chuỗi ngẫu nhiên dài, giữ bí mật tuyệt đối
JWT_SECRET=thay-doi-chuoi-nay-thanh-chuoi-bi-mat-that-dai-va-kho-doan

# Domain frontend được phép gọi API (CORS)
FRONTEND_ORIGIN=http://localhost:5500

# Hạn mức tổng dung lượng tài liệu (MB) — để trống để dùng giá trị mặc định
# (200MB/khách hàng, 100MB/dự án) trong src/middleware/upload.js
QUOTA_USER_MB=200
QUOTA_PROJECT_MB=100
